{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node26/tsconfig.json"],
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "checkJs": true,

    // the sources run as they are on Node (type stripping): erasable syntax only, `import type` for types,
    // and imports with their .ts extension, rewritten to .js in the build
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.mjs",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "eslint.config.mjs"
  ]
}
