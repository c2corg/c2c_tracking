{
  "name": "c2c_tracking",
  "version": "2.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Tiny server to handle connection with activity trackers such as Strava, Garmin or Suunto",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts | pino-pretty -c -t",
    "backfill:strava": "ts-node scripts/backfill-strava-activities.ts | pino-pretty -c -t",
    "backfill:suunto": "ts-node scripts/backfill-suunto-activities.ts | pino-pretty -c -t",
    "backfill:decathlon": "ts-node scripts/backfill-decathlon-activities.ts | pino-pretty -c -t",
    "backfill:coros": "ts-node scripts/backfill-coros-activities.ts | pino-pretty -c -t",
    "backfill:garmin": "ts-node scripts/backfill-garmin-activities.ts | pino-pretty -c -t",
    "start:dev": "node --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node src/index.ts | pino-pretty -c -t -i req.headers,res.headers\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "prettier --check \"**/*.{ts,js,json,css,scss,less,md,html}\" && eslint --report-unused-disable-directives --ext .ts,.js .",
    "prepare": "husky",
    "test": "vitest run --project unit --project psql",
    "test:unit": "vitest run --project unit",
    "test:psql": "vitest run --project psql",
    "test:s3": "vitest run --project s3",
    "test:watch": "vitest --project unit",
    "test:ci": "npm run test:ci:unit && npm run test:ci:s3 && npm run test:ci:psql",
    "test:ci:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=reports/coverage/unit --reporter=default --reporter=junit --outputFile.junit=reports/junit/unit.xml",
    "test:ci:psql": "vitest run --project psql --coverage --coverage.reportsDirectory=reports/coverage/psql --reporter=default --reporter=junit --outputFile.junit=reports/junit/psql.xml",
    "test:ci:s3": "vitest run --project s3 --coverage --coverage.reportsDirectory=reports/coverage/s3 --reporter=default --reporter=junit --outputFile.junit=reports/junit/s3.xml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c2corg/c2c_tracking.git"
  },
  "author": "https://www.camptocamp.org",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/c2corg/c2c_tracking/issues"
  },
  "homepage": "https://github.com/c2corg/c2c_tracking#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@c2corg/fit-parser-extract-geometry": "1.0.3",
    "@keyv/redis": "5.1.3",
    "@koa/cors": "5.0.0",
    "@koa/router": "13.1.0",
    "@mapbox/polyline": "1.2.1",
    "@paralleldrive/cuid2": "2.2.2",
    "@types/json-bigint": "1.0.4",
    "async": "3.2.6",
    "axios": "1.21.0",
    "cls-rtracer": "2.6.3",
    "convict": "6.2.4",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.19",
    "debug": "4.4.1",
    "dotenv": "17.2.3",
    "dotenv-expand": "12.0.3",
    "iso8601-duration": "2.1.3",
    "json-bigint": "1.0.0",
    "keyv": "5.5.3",
    "knex": "3.1.0",
    "koa": "3.1.1",
    "koa-bodyparser": "4.4.1",
    "koa-helmet": "8.0.1",
    "koa-passport": "6.0.0",
    "koa-pino-logger": "4.0.0",
    "node-watch": "0.7.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "sanitize-filename": "1.6.3",
    "tiny-invariant": "1.3.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "validator": "13.15.23",
    "zod": "3.25.48"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/async": "3.2.25",
    "@types/convict": "6.1.6",
    "@types/crypto-js": "4.2.2",
    "@types/koa": "3.0.1",
    "@types/koa__cors": "5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/koa-bodyparser": "4.3.13",
    "@types/koa-passport": "6.0.3",
    "@types/koa-pino-logger": "3.0.5",
    "@types/mapbox__polyline": "1.0.5",
    "@types/node": "22.15.29",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.4",
    "@typescript-eslint/eslint-plugin": "7.9.0",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "node-mocks-http": "1.17.2",
    "passport-custom": "1.1.1",
    "pino-pretty": "13.2.0",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "type-fest": "5.10.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "diff": "^4.0.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --report-unused-disable-directives",
      "prettier --write --ignore-unknown --list-different"
    ],
    "*.{json,md}": [
      "prettier --write --ignore-unknown --list-different"
    ]
  }
}
