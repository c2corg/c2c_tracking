{
  "name": "c2c_tracking",
  "version": "2.5.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Tiny server to handle connection with activity trackers such as Strava, Garmin or Suunto",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts | pino-pretty -c -t",
    "backfill:strava": "node --env-file-if-exists=.env scripts/backfill-strava-activities.ts | pino-pretty -c -t",
    "backfill:suunto": "node --env-file-if-exists=.env scripts/backfill-suunto-activities.ts | pino-pretty -c -t",
    "backfill:decathlon": "node --env-file-if-exists=.env scripts/backfill-decathlon-activities.ts | pino-pretty -c -t",
    "backfill:coros": "node --env-file-if-exists=.env scripts/backfill-coros-activities.ts | pino-pretty -c -t",
    "backfill:garmin": "node --env-file-if-exists=.env scripts/backfill-garmin-activities.ts | pino-pretty -c -t",
    "start:dev": "node --watch --env-file-if-exists=.env src/index.ts | pino-pretty -c -t -i req.headers,res.headers",
    "build": "tsc -p tsconfig.build.json",
    "lint": "prettier --check \"**/*.{ts,js,json,css,scss,less,md,html}\" && eslint . && tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run --project unit --project psql",
    "test:unit": "vitest run --project unit",
    "test:psql": "vitest run --project psql",
    "test:s3": "vitest run --project s3",
    "test:watch": "vitest --project unit",
    "test:ci": "npm run test:ci:unit && npm run test:ci:s3 && npm run test:ci:psql",
    "test:ci:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=reports/coverage/unit --reporter=default --reporter=junit --outputFile.junit=reports/junit/unit.xml",
    "test:ci:psql": "vitest run --project psql --coverage --coverage.reportsDirectory=reports/coverage/psql --reporter=default --reporter=junit --outputFile.junit=reports/junit/psql.xml",
    "test:ci:s3": "vitest run --project s3 --coverage --coverage.reportsDirectory=reports/coverage/s3 --reporter=default --reporter=junit --outputFile.junit=reports/junit/s3.xml",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c2corg/c2c_tracking.git"
  },
  "author": "https://www.camptocamp.org",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/c2corg/c2c_tracking/issues"
  },
  "homepage": "https://github.com/c2corg/c2c_tracking#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@c2corg/fit-parser-extract-geometry": "2.0.0",
    "@keyv/redis": "6.1.0",
    "@mapbox/polyline": "1.2.1",
    "@paralleldrive/cuid2": "3.3.0",
    "async": "3.2.6",
    "axios": "1.21.0",
    "convict": "6.2.5",
    "cors": "2.8.6",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.23",
    "debug": "4.4.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "http-errors": "2.0.1",
    "iso8601-duration": "2.2.0",
    "keyv": "6.1.0",
    "knex": "3.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "sanitize-filename": "1.6.4",
    "tiny-invariant": "1.3.3",
    "validator": "13.15.35",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/async": "3.2.26",
    "@types/convict": "6.1.6",
    "@types/cors": "2.8.19",
    "@types/crypto-js": "4.2.2",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/json-bigint": "1.0.4",
    "@types/mapbox__polyline": "1.0.5",
    "@types/node": "26.6.6",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "json-bigint": "1.0.0",
    "lint-staged": "17.6.0",
    "node-mocks-http": "1.18.1",
    "passport-custom": "1.2.1",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "diff": "^4.0.4"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write --ignore-unknown --list-different"
    ],
    "*.{json,md}": [
      "prettier --write --ignore-unknown --list-different"
    ]
  }
}
